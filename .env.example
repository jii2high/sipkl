APP_NAME="SIM PKL SMKN 1 Kota Bekasi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# DB menyimpan waktu UTC; tanggal kalender memakai Asia/Jakarta (TRD.md §15).
APP_TIMEZONE=UTC
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0.16+ wajib: JSON, CHECK, generated column.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipkl
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Lampiran PKL bersifat privat: tidak pernah di disk publik.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@smkn1kotabekasi.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Hanya email pada domain ini yang boleh login (F1).
PKL_EMAIL_DOMAIN=smkn1kotabekasi.sch.id

# Di lingkungan `local`, seluruh email dialihkan ke alamat nyata untuk uji OTP.
PKL_MAIL_OVERRIDE_TO=

VITE_APP_NAME="${APP_NAME}"
